{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steward-menu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://steward-backend-qwd2.onrender.com/v1",
    "NEXT_PUBLIC_BACKEND_URL": "https://steward-backend-qwd2.onrender.com/v1",
    "NEXT_PUBLIC_WS_URL": "https://steward-backend-qwd2.onrender.com"
  }
}
