# ─── Steward Menu — Production Environment Variables ────────────────────────────────────
#
# These variables are embedded at build time by Next.js.
#

# Backend API base URL
NEXT_PUBLIC_API_URL=https://steward-backend.onrender.com/v1
NEXT_PUBLIC_BACKEND_URL=https://steward-backend.onrender.com/v1

# Backend WebSocket URL
NEXT_PUBLIC_WS_URL=https://steward-backend.onrender.com

# Default slug (fallback for home page routing)
NEXT_PUBLIC_DEFAULT_SLUG=spice-garden
